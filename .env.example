# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://wedding:secret@localhost:3306/wedding_db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="30m"

# Google Sign-In — OAuth 2.0 Client ID (type: Web application) from
# https://console.cloud.google.com/apis/credentials . Leave blank to disable.
GOOGLE_CLIENT_ID=""

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Search ───────────────────────────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV="development"

# ─── Gold price (daily fetch job) ─────────────────────────────────────────────
# Cron + timezone for the LBMA fetch. Default: 16:15 on London business days.
GOLD_PRICE_CRON="15 16 * * 1-5"
GOLD_PRICE_TZ="Europe/London"
# Retail/jeweller premium added on top of metal value (0–1). 0 = pure metal.
GOLD_PRICE_RETAIL_PREMIUM_PCT=0
# Fetch once on boot if the latest stored snapshot is missing or stale.
GOLD_PRICE_REFRESH_ON_BOOT=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Same OAuth 2.0 Client ID as GOOGLE_CLIENT_ID above (safe to expose to the browser).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

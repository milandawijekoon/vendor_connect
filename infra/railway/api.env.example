# ─────────────────────────────────────────────────────────────────────────────
# Railway → "api" service → Variables → Raw Editor → paste this, then fill in.
# Railway does NOT read .env files from the repo — variables live on the service.
# ${{ ... }} are Railway reference variables (resolved at deploy time).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Railway injects PORT; the app also honours API_PORT as a fallback.
API_PORT=${{ PORT }}

# ── Database ────────────────────────────────────────────────────────────────
# Railway MySQL plugin:  ${{ MySQL.MYSQL_URL }}
# External / AWS RDS:     mysql://user:pass@host:3306/dbname
DATABASE_URL=${{ MySQL.MYSQL_URL }}

# ── Auth ───────────────────────────────────────────────────────────────────
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=IyWVECu7-Z3aDiozjuapiukIE4l6tA0SOcbiJeEcSLM_k9vnk9HpIFVcfLTb7oop
JWT_EXPIRES_IN=30m

# CORS allow-list — the public URL of the web service.
FRONTEND_URL=https://${{ web.RAILWAY_PUBLIC_DOMAIN }}

# Google Sign-In (optional; leave blank to disable)
GOOGLE_CLIENT_ID=

# ── Search (Meilisearch service) ───────────────────────────────────────────
MEILISEARCH_HOST=http://${{ meilisearch.RAILWAY_PRIVATE_DOMAIN }}:7700
MEILISEARCH_API_KEY=replace-with-the-meili-master-key

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mail (optional) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vendorconnect.lk

# ── Gold price job (optional; sensible defaults baked in) ───────────────────
GOLD_PRICE_CRON=15 16 * * 1-5
GOLD_PRICE_TZ=Europe/London
GOLD_PRICE_RETAIL_PREMIUM_PCT=0
GOLD_PRICE_REFRESH_ON_BOOT=true

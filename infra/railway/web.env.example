# ─────────────────────────────────────────────────────────────────────────────
# Railway → "web" service → Variables → Raw Editor → paste this, then fill in.
# NEXT_PUBLIC_* values are inlined at BUILD time (the Dockerfile forwards them
# as build args), so changing them requires a redeploy/rebuild.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Public URL of the api service + the /api/v1 prefix.
NEXT_PUBLIC_API_URL=https://${{ api.RAILWAY_PUBLIC_DOMAIN }}/api/v1

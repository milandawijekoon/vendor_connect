# ─────────────────────────────────────────────────────────────────────────────
# Railway → "meilisearch" service (Docker image getmeili/meilisearch:v1.9)
# → Variables → Raw Editor. Also add a Volume mounted at /meili_data.
# ─────────────────────────────────────────────────────────────────────────────

MEILI_MASTER_KEY=replace-with-a-long-random-key-and-reuse-it-as-api-MEILISEARCH_API_KEY
MEILI_ENV=production
MEILI_NO_ANALYTICS=true
